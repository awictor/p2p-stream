{
  "name": "p2p-stream-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP: prove P2P bandwidth offload for live browser streaming (hls.js + p2p-media-loader + WS tracker)",
  "scripts": {
    "start": "bash start.sh",
    "start:vod": "bash start.sh vod origin/vod.mp4",
    "tracker": "node server/tracker.js",
    "web": "http-server web -p 5173 -c-1 --cors",
    "origin:loop": "bash origin/segment.sh loop origin/sample.mp4",
    "origin:rtmp": "bash origin/segment.sh rtmp",
    "nginx": "bash origin/run-nginx.sh",
    "test": "node scripts/check-configs.mjs && node test/metrics.test.js && node test/tracker.test.js && node test/config.test.js && node test/dashboard.test.js && node test/start.test.js && node test/ledger.test.js && node test/claim.test.js && node test/participation.test.js && node test/forgery.test.js && node test/sybil.test.js && node test/segment.test.js && node test/origin.test.js && node test/viewer.test.js && node test/spread.test.js && node test/deploy.test.js && node test/verdict.test.js && node test/compose.test.js && node test/checkconfigs.test.js && node test/runnginx.test.js && node test/remote.test.js && node test/twomachine.test.js && node test/hostcount.test.js && node test/ceiling.test.js && node test/sanitize.test.js",
    "test:metrics": "node test/metrics.test.js",
    "test:tracker": "node test/tracker.test.js",
    "test:config": "node test/config.test.js",
    "test:dashboard": "node test/dashboard.test.js",
    "test:start": "node test/start.test.js",
    "verify": "node test/verify-offload.js",
    "verify:sweep": "node test/verify-offload.js --sweep 1,2,4,8 --watch 45",
    "verify:control": "node test/verify-offload.js --control --watch 45",
    "verify:remote": "node test/verify-offload.js --remote",
    "test:ledger": "node test/ledger.test.js",
    "test:claim": "node test/claim.test.js",
    "verify:windows": "node test/verify-offload.js --windows default,600,120,30 --watch 40",
    "verify:participation": "node test/verify-offload.js --participation 100,75,50,25 --watch 40",
    "test:participation": "node test/participation.test.js",
    "test:forgery": "node test/forgery.test.js",
    "test:sybil": "node test/sybil.test.js",
    "test:segment": "node test/segment.test.js",
    "test:origin": "node test/origin.test.js",
    "test:viewer": "node test/viewer.test.js",
    "test:spread": "node test/spread.test.js",
    "test:deploy": "node test/deploy.test.js",
    "test:verdict": "node test/verdict.test.js",
    "test:compose": "node test/compose.test.js",
    "check:configs": "node scripts/check-configs.mjs",
    "test:checkconfigs": "node test/checkconfigs.test.js",
    "test:runnginx": "node test/runnginx.test.js",
    "test:remote": "node test/remote.test.js",
    "test:twomachine": "node test/twomachine.test.js",
    "test:hostcount": "node test/hostcount.test.js",
    "test:ceiling": "node test/ceiling.test.js",
    "test:sanitize": "node test/sanitize.test.js"
  },
  "dependencies": {
    "bittorrent-tracker": "^11.2.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "ws": "^8.21.2",
    "yaml": "^2.9.0"
  }
}
