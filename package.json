{
  "name": "p2p-stream-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP: prove P2P bandwidth offload for live browser streaming (hls.js + p2p-media-loader + WS tracker)",
  "scripts": {
    "start": "bash start.sh",
    "start:vod": "bash start.sh vod origin/vod.mp4",
    "tracker": "node server/tracker.js",
    "web": "http-server web -p 5173 -c-1 --cors",
    "origin:loop": "bash origin/segment.sh loop origin/sample.mp4",
    "origin:rtmp": "bash origin/segment.sh rtmp",
    "nginx": "bash origin/run-nginx.sh",
    "test": "node test/metrics.test.js && node test/tracker.test.js && node test/config.test.js && node test/dashboard.test.js && node test/start.test.js && node test/ledger.test.js && node test/claim.test.js",
    "test:metrics": "node test/metrics.test.js",
    "test:tracker": "node test/tracker.test.js",
    "test:config": "node test/config.test.js",
    "test:dashboard": "node test/dashboard.test.js",
    "test:start": "node test/start.test.js",
    "verify": "node test/verify-offload.js",
    "verify:sweep": "node test/verify-offload.js --sweep 1,2,4,8 --watch 45",
    "verify:control": "node test/verify-offload.js --control --watch 45",
    "test:ledger": "node test/ledger.test.js",
    "test:claim": "node test/claim.test.js",
    "verify:windows": "node test/verify-offload.js --windows default,600,120,30 --watch 40"
  },
  "dependencies": {
    "bittorrent-tracker": "^11.2.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "ws": "^8.21.2"
  }
}
