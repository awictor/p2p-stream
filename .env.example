# p2p-stream — environment variables (defaults shown)
#
# Every var here has a working default; the stack runs with none of them set. Copy to `.env` only
# to override. This file holds DEFAULTS/PLACEHOLDERS ONLY — never commit real secrets (HARD RULE 5).
# The security guards below are the knobs SECURITY.md tells an operator to tune.

# --- Ports (server/tracker.js) ---
PORT=8000                       # WS signaling tracker
METRICS_PORT=8001               # metrics dashboard + /stats

# --- Signaling hardening (server/tracker.js) ---
WS_MAX_PAYLOAD=65536            # max WS frame bytes (64KB). Real SDP+ICE is a few KB; the ws
                                # library default is 100MB — see P2P-0062 / SECURITY.md.

# --- Peer identity / signed credit (server/metrics.js, server/identity.js) ---
# The tracker's PUBLIC key (base64 spki ed25519). When set, metrics counts certifiedAttestedBytes
# only for attestations whose pubKey carries a tracker-issued cert (P2P-0070). Unset (default) =>
# nothing is certifiable, certifiedAttestedBytes stays 0. Metrics NEVER holds the tracker private key.
TRACKER_PUBKEY=
# The tracker's identity keypair (base64). Set BOTH to pin it across restarts; if unset the tracker
# generates an ephemeral pair at boot and logs the public key to copy into TRACKER_PUBKEY above.
# HARD RULE 5: this is a secret — never commit a real value; it lives only on the tracker host.
TRACKER_PRIVKEY=
# Port for the tracker's cert-issuance endpoint (POST /issue, GET /pubkey) — server/tracker.js.
ISSUER_PORT=8002
# Proof-of-work difficulty (leading zero bits) required to obtain a cert from /issue (P2P-0079).
# 0 (default) = OFF: any pubKey gets a cert. >0 = a client must GET /issue/challenge and POST a nonce
# solving it, pricing a certified sybil ring in CPU (~2^bits hashes per cert). PoW prices issuance, it
# does NOT prove a distinct human. ~20 bits is a fraction of a second; tune to taste.
ISSUE_POW_BITS=0

# --- Metrics request hardening (server/metrics.js) ---
METRICS_BODY_LIMIT=16kb         # max POST /metrics body; a real report is a few KB (express default 100kb)

# --- Metrics resident-state ceilings (server/metrics.js) ---
# All are positive-integer validated: a garbage value falls back to the default and warns (iter 84).
MAX_CLIENTS=5000                # hard cap on tracked clients; evict oldest when full (P2P-0061)
MAX_ATTEST_KEYS=256             # max attested peers accepted per /metrics POST
MAX_RECEIPTS=256                # max proof-of-delivery receipts accepted per /metrics POST (P2P-0073)
AD_FREE_BYTES_PER_SECOND=1000000 # relay bytes per 1 ad-free second (entitlement policy rate, P2P-0075)
MAX_CLIENTID_LEN=128            # clientId is clamped to this length before use as a Map key
MAX_REPORT_BYTES=1000000000000  # per-report byte clamp (1TB); stops one POST poisoning offloadRatio (P2P-0063)

# --- Upload attestation / forgery signal (server/metrics.js) ---
MIN_ATTESTERS=2                 # K in the K-of-N filter: min distinct receivers to credit an upload
MAX_VOUCH_PER_ATTESTER=20000000 # cap one receiver can vouch for another (20MB)

# --- verify harness targets (test/verify-offload.js) ---
# Point verify:remote / verify at a different stack (e.g. a LAN origin for the two-machine run).
STATS_URL=http://localhost:8001/stats
VIEWER_URL=http://localhost:5173/index.html
PLAYLIST_URL=http://localhost:8080/hls/stream.m3u8

# --- Pricing extrapolation for verify:control (test/verify-offload.js) ---
EGRESS_RATE_NAME=cloudfront     # named CDN rate: cloudflare(0) | cloudfront | fastly | gcs
EGRESS_USD_PER_GB=              # override $/GB directly (blank = use the named rate)
EGRESS_VIDEO_HOURS=730          # video-hours/month assumed when extrapolating a monthly bill
